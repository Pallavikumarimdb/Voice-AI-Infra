{
  "name": "voice-translate-gateway",
  "version": "0.1.0",
  "description": "WebSocket Gateway for streaming voice translation pipeline",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "test": "node --experimental-strip-types --test tests/**/*.test.ts",
