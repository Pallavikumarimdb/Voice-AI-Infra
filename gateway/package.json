  },
  "dependencies": {
    "@voice/protocol": "*",
    "dotenv": "^16.4.5",
    "prom-client": "^15.1.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "@types/ws": "^8.5.10",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
