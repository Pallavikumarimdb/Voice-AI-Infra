# ==============================================================================
# Streaming Voice Translation Pipeline - Environment Configuration
# ==============================================================================

# Gateway Configuration
GATEWAY_PORT=8443
GATEWAY_HOST=0.0.0.0
MAX_BUFFERED_BYTES=65536

# STT Service Configuration
STT_HOST=0.0.0.0
STT_PORT=8001
STT_MODEL_SIZE=large-v3-turbo
STT_DEVICE=cuda
STT_COMPUTE_TYPE=float16
VAD_THRESHOLD=0.5
HANGOVER_MS=500
PREROLL_MS=200
MAX_LEN_MS=18000
LOCAL_AGREEMENT_N=2
MIN_CHUNK_MS=500

# MT Service Configuration (vLLM)
MT_HOST=0.0.0.0
MT_PORT=8002
MT_MODEL=Qwen/Qwen2.5-7B-Instruct
MT_GPU_MEMORY_UTILIZATION=0.85
MT_MAX_NUM_SEQS=64
MT_DTYPE=float16
MT_DEVICE=cuda

# Inter-Service URLs (Docker internal network or localhost)
STT_SERVICE_URL=ws://stt-service:8001/stream
MT_SERVICE_URL=http://mt-service:8002/translate
TTS_SERVICE_URL=http://tts-service:8003/synthesize

# Observability
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
